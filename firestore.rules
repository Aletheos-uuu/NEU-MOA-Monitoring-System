rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email.endsWith('@neu.edu.ph');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function canManage() {
      return getUserData().canManageMOA == true;
    }

    // User rules
    match /users/{userId} {
      // Authenticated @neu.edu.ph users can read/write their own document
      // Admins can read/write all user documents
      allow read, write: if isSignedIn() && (request.auth.uid == userId || getRole() == 'admin');
    }

    // MOA rules
    match /moas/{moaId} {
      allow read: if isSignedIn() && (
        // Admins can read all records (including deleted)
        getRole() == 'admin' ||
        // Faculty can read all non-deleted records
        (getRole() == 'faculty' && resource.data.isDeleted == false) ||
        // Students can only read non-deleted, approved records
        (getRole() == 'student' && 
         resource.data.isDeleted == false && 
         resource.data.status.upper().startsWith('APPROVED'))
      );
      
      allow create: if isSignedIn() && (
        getRole() == 'admin' || 
        (getRole() == 'faculty' && canManage())
      );
      
      allow update: if isSignedIn() && (
        // Admins can update everything
        getRole() == 'admin' || 
        // Faculty with management permission can update non-deleted fields
        (getRole() == 'faculty' && canManage() && 
         // Faculty cannot change deletion status (soft delete or recover)
         request.resource.data.isDeleted == resource.data.isDeleted)
      );
      
      // Only admins can perform hard deletes (though the app uses soft deletes)
      allow delete: if isSignedIn() && getRole() == 'admin';
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}